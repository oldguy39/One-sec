<?xml version="1.0" encoding="utf-8"?>
<!-- Listens to almost no accessibility events (only its own app's announcements),
     so it never wakes up for anything except the screen on/off signal. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/service_desc"
    android:accessibilityEventTypes="typeAnnouncement"
    android:packageNames="com.john.onesecoff"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canRetrieveWindowContent="false" />
